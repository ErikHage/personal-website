<!DOCTYPE html>
<html lang="en">
<%- include('../partials/_head', {
    title: 'Erik Hage: Reading Log',
    pagePath: '/reading/log',
    stylesheet: 'about-me',
    description: 'Books Erik Hage has read, with start and finish dates.',
}); %>
<body>

<%
function formatDate(date) {
    if (date === null || date === undefined) {
        return "";
    }
    return date.toLocaleDateString('en-us', {
        year: "numeric",
        month: "short",
        day: "numeric"
    });
}
function calculateDays(start, finish) {
    if (finish === null || finish === undefined) {
        return "";
    }
    return Math.round((finish - start) / (1000 * 60 * 60 * 24)) + 1;
}
%>

<%- include('../partials/_nav'); %>

<div class="container-fluid scroll-spy-area">
    <div class="row">
        <div class="col-12 col-lg-8 offset-lg-2 content-pane">

            <div class="page-title text-center">
                <h1 class="h2">Reading Log</h1>
            </div>

            <div class="row">
                <div class="col-0 col-md-1"></div>
                <div class="col-12 col-md-10">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-sm">
                            <thead>
                            <tr>
                                <th style="width: 30%">Title</th>
                                <th style="width: 5%">#</th>
                                <th style="width: 20%">Author</th>
                                <th style="width: 10%">Start</th>
                                <th style="width: 10%">Finish</th>
                                <th style="width: 5%">Days</th>
                            </tr>
                            </thead>
                            <tbody>
                            <% readingLog.forEach(record => { %>
                                <tr>
                                    <td class="text-wrap"><%= record.title %></td>
                                    <td><%= record.installment %></td>
                                    <td class="text-wrap"><%= record.author %></td>
                                    <td><%= formatDate(record.start) %></td>
                                    <td><%= formatDate(record.finish) %></td>
                                    <td><%= calculateDays(record.start, record.finish) %></td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-0 col-md-1"></div>
            </div>

        </div>
    </div>
    <%- include('../partials/_footer'); %>
</div>
</body>
</html>
