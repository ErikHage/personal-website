<!DOCTYPE html>
<html lang="en">
<%- include('./partials/_head', {
    title: 'Erik Hage',
    pagePath: '/',
    stylesheet: 'index',
    description: 'Personal website of Erik B. Hage: hobbies, personal projects and professional experience.',
}); %>
<body>
<%- include('./partials/_nav'); %>
<div class="container-fluid">

    <div class="row">
        <div class="col-12 col-lg-8 offset-lg-2 content-pane">

            <div class="row">
                <div class="col-sm-0 col-lg-3"></div>
                <div class="col-sm-12 col-lg-6 text-center">
                    <h1 class="h2">Personal Website of Erik B. Hage</h1>
                </div>
                <div class="col-sm-0 col-lg-3"></div>
            </div>

            <div class="row">
                <div class="col-sm-1 col-lg-3"></div>
                <div class="col-sm-10 col-lg-6 text-center">
                    <img class="img-fluid profile-pic" src="/images/erik.jpg" alt="Photo of Erik">

                    <span class="intro-paragraph">
                        Hi, my name is Erik Hage. Welcome to my personal website.
                    </span>

                    <br/>

                    <span class="intro-paragraph">
                        Check out some of my <a href="/about-me#hobbies">hobbies</a>. I like to cook,
                        garden, write code, build stuff, and play games. Or maybe take a look at
                        some <a href="/personal-projects">personal projects</a> I'm working on,
                        like this one:
                    </span>

                    <br/>

                    <div class="row">
                        <div class="col-0 col-lg-2"></div>
                        <div class="col-0 col-lg-8">
                            <div class="card project-card">
                                <div class="card-header">
                                    <div>
                                        <span class="project-name"><%= highlights.project.projectName %></span>
                                        <% highlights.project.iconLinks.forEach((iconLink) => { %>
                                            <a class="<%= iconLink.buttonClasses %>" href="<%= iconLink.link %>"
                                               target="_blank" data-bs-toggle="tooltip" data-bs-placement="top"
                                               title="<%= iconLink.tooltip %>" aria-label="<%= iconLink.tooltip %>: <%= highlights.project.projectName %>"><i class="<%= iconLink.fontAwesomeClasses %>"></i></a>
                                        <% }); %>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="project-summary"><span><%- highlights.project.summary %></span></div>

                                    <% highlights.project.skillsUsed.forEach((skill) => { %>
                                        <span class="badge <%= skillColorMap[skill] %>"><%= skill %></span>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                        <div class="col-0 col-lg-2"></div>
                    </div>
                </div>
                <div class="col-sm-1 col-lg-3"></div>
            </div>

        </div>
    </div>

    <%- include('./partials/_footer'); %>
</div>
</body>
</html>
