<!DOCTYPE html>
<html lang="en">
<%- include('./partials/_head', {
    title: 'Erik Hage: Personal Projects',
    pagePath: '/personal-projects',
    stylesheet: 'personal-projects',
    script: 'image-gallery',
    description: 'Personal projects by Erik Hage, with the skills used in each.',
}); %>
<body>
<%- include('./partials/_nav'); %>
<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-8 offset-lg-2 content-pane">

            <div class="page-title text-center">
                <h1 class="h2">Personal Projects</h1>
            </div>

            <div class="row">
                <div class="col-0 col-md-1"></div>
                <div class="col-12 col-md-10">
                    <div class="row">
                        <% personalProjects.forEach((project, i) => { %>
                            <div class="col-12 col-md-6 bottom-margin-15">
                                <div class="card project-card">
                                    <div class="card-header">
                                        <div>
                                            <span class="project-name"><%= project.projectName %></span>
                                            <% project.iconLinks.forEach((iconLink) => { %>
                                                <a class="<%= iconLink.buttonClasses %>" href="<%= iconLink.link %>"
                                                   target="_blank" data-bs-toggle="tooltip" data-bs-placement="top"
                                                   title="<%= iconLink.tooltip %>" aria-label="<%= iconLink.tooltip %>: <%= project.projectName %>"><i class="<%= iconLink.fontAwesomeClasses %>"></i></a>
                                            <% }); %>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="project-summary"><span><%- project.summary %></span></div>

                                        <% project.skillsUsed.forEach((skill) => { %>
                                            <span class="badge <%= skillColorMap[skill] %>"><%= skill %></span>
                                        <% }); %>

                                        <% if (project.images.length > 0) { %>
                                            <% const collapseId = `collapse${i}`; %>
                                            <span>|</span>
                                            <button type="button" class="gallery-toggle" data-bs-toggle="collapse" data-bs-target="#<%= collapseId %>"
                                                    aria-expanded="false" aria-controls="<%= collapseId %>" aria-label="Show or hide photos: <%= project.projectName %>"><i class="fa-solid fa-camera"></i><i class="fa-solid fa-chevron-down"></i></button>
                                            <div id="<%= collapseId %>" class="collapse">
                                                <hr />
                                                <div class="row text-center text-lg-start thumbnails-row">
                                                    <% project.images.forEach((image) => { %>
                                                    <div class="my-thumbnail-anchor-wrapper">
                                                        <a href="#" class="d-block ma-6 h-100 my-thumbnail-anchor" data-bs-toggle="modal" data-bs-target="#imageModal">
                                                            <img class="img-fluid img-thumbnail my-thumbnail" src="<%= image.imagePath %>" alt="<%= image.caption %>">
                                                        </a>
                                                    </div>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
                <div class="col-0 col-md-1"></div>
            </div>

        </div>
    </div>

    <div id="imageModal" class="modal" tabindex="-1" aria-labelledby="modelCurrentCaption" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <span id="modelCurrentCaption" class="modal-title">Image Preview</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalCurrentImage" class="img-fluid" src="" alt="">
                </div>
            </div>
        </div>
    </div>

    <%- include('./partials/_footer'); %>
</div>
</body>
</html>
