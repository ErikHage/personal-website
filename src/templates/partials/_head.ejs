<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>

    <title><%= title %></title>
<% if (locals.description) { %>
    <meta name="description" content="<%= description %>"/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content="<%= title %>"/>
    <meta property="og:description" content="<%= description %>"/>
    <meta property="og:url" content="<%= urls.SITE %><%= pagePath %>"/>
    <meta property="og:image" content="<%= urls.SITE %>/images/erik.jpg"/>
<% } %>

    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/main.css">
<% if (locals.stylesheet) { %>
    <link rel="stylesheet" href="/stylesheets/<%= stylesheet %>.css">
<% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/97921a8cee.js" crossorigin="anonymous"></script>
<% if (locals.script) { %>
    <script src="/javascripts/<%= script %>.js" defer></script>
<% } %>
</head>
