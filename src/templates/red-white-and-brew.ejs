<!DOCTYPE html>
<html lang="en">
<%- include('./partials/_head', {
    title: 'Erik Hage: RW&B',
    pagePath: '/red-white-and-brew',
    stylesheet: 'red-white-and-brew',
    description: 'The Red White & Brew Beer Company, a production microbrewery serving Camden and Gloucester counties from 2016 to 2025.',
}); %>
<body>

<%- include('./partials/_nav'); %>

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-8 offset-lg-2 content-pane">

            <div class="page-title text-center">
                <h1 class="h2">Red White & Brew Beer Company</h1>
            </div>

            <div class="row">
                <div class="col text-center">
                    <img class="img-fluid company-logo" src="/images/logos/rwab_logo.jpeg" alt="rw&b logo">
                </div>
            </div>

            <div class="row">
                <div class="col-0 col-lg-1"></div>
                <div class="col-12 col-lg-10">
                    <div class="card">
                        <div class="card-header rwbbc-intro">
                            <span class="rwbbc-intro-paragraph">
                                The Red White and Brew Beer Company was founded in 2016 with the goal of providing the
                                citizens of Camden and Gloucester counties with high quality craft beer. We operated as
                                a production microbrewery serving up artisanal craft ales to local beer lovers and
                                connoisseurs until February 2025. The demands of the business got to be too much to
                                manage with full time jobs and families, so we regretfully closed our doors.
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-0 col-lg-1"></div>
            </div>

            <hr/>

            <div class="row">
                <div class="col-0 col-lg-4"></div>
                <div class="col-12 col-lg-4">
                    <div id="rwbCarousel" class="carousel slide" data-bs-ride="carousel">
                        <!-- Indicators/dots -->
                        <div class="carousel-indicators">
                            <% rwabData.images.forEach((image, i) => {
                                const indicatorClasses = i === 0 ? 'active' : '';
                            %>
                            <button type="button" class="<%= indicatorClasses ;%>" data-bs-target="#rwbCarousel"
                                    data-bs-slide-to="<%= i ;%>" aria-label="Slide <%= i + 1 ;%>"></button>
                            <% }); %>
                        </div>

                        <!-- The content -->
                        <div class="carousel-inner">
                            <% rwabData.images.forEach((image, i) => {
                                const contentClasses = i === 0 ? 'carousel-item img-fluid active' : 'carousel-item img-fluid';
                            %>
                            <div class="<%= contentClasses ;%>">
                                <img src="<%= image.imagePath ;%>" alt="<%= image.caption ;%>" class="d-block w-100">
                                <div class="carousel-caption-wrapper">
                                    <p class="carousel-caption"><%= image.caption ;%></p>
                                </div>
                            </div>
                            <% }); %>
                        </div>

                        <!-- Left and right controls/icons -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#rwbCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#rwbCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
                <div class="col-2 col-lg-4"></div>
            </div>

        </div>
    </div>

    <%- include('./partials/_footer'); %>
</div>
</body>
</html>
