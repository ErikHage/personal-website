{
  "name": "personal-website",
  "version": "1.0.0",
  "description": "My personal website",
  "author": "Erik Hage",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "ts-node tools/clean",
    "tsc": "tsc",
    "build": "npm run clean && npm run lint && npm run tsc && npm run copy-assets",
    "copy-assets": "ts-node tools/copy-assets",
    "postbuild": "",
    "dev:start": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env ./dist/src/server.js",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/src/**/*.test.js\"",
    "dev": "nodemon --watch src --watch public/stylesheets -e ts,ejs --exec npm run dev:start",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.17",
    "@types/node": "^24.19.2",
    "@types/serve-favicon": "^2.5.4",
    "@types/shelljs": "^0.10.0",
    "eslint": "^10.14.0",
    "nodemon": "^3.1.0",
    "shelljs": "^0.10.0",
    "ts-node": "^10.9.1",
    "typescript": "5.0.4",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
